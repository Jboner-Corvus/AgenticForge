# =================================================================
# 🔧 CONFIGURATION ROBUSTESSE AGENT
# =================================================================
# Paramètres pour améliorer la robustesse de l'agent
AGENT_MAX_ITERATIONS=50             # Beaucoup augmenté pour robustesse
AGENT_MAX_MALFORMED_RESPONSES=10    # Beaucoup plus de tolérance
AGENT_MAX_LLM_FAILURES=10           # Beaucoup plus de tolérance aux échecs
GEMINI_REQUEST_TIMEOUT_MS=60000     # Timeout très long pour Gemini (60s)
GEMINI_MAX_HISTORY_LENGTH=20        # Réduire encore l'historique 
LLM_REQUEST_DELAY_MS=10000          # Délai plus long entre requêtes (10s)
GEMINI_MAX_RETRIES=5                # Nombre de retry pour Gemini
GEMINI_RETRY_DELAY_MS=5000          # Délai entre les retry (5s)

# =================================================================
# 🗄️ BASE DE DONNÉES POSTGRESQL
# =================================================================
# Configuration de la base de données principale
# When running outside Docker, use localhost to connect to Docker-exposed ports
POSTGRES_HOST=localhost             # Use localhost to connect to Docker container
POSTGRES_USER=user                  # Nom d'utilisateur
POSTGRES_PASSWORD=password          # Mot de passe (doit correspondre à Docker)
POSTGRES_DB=gforge                  # Nom de la base de données

# =================================================================
# 🔴 REDIS (Cache & Messages)
# =================================================================
# Configuration Redis pour le cache et la messagerie
# When running outside Docker, use localhost to connect to Docker-exposed ports
REDIS_HOST=localhost                # Use localhost to connect to Docker container
REDIS_PORT=6379                     # Port Redis standard
REDIS_HOST_PORT=6379               # Port exposé sur l'hôte
REDIS_PASSWORD=""                   # Mot de passe Redis (vide = pas de mot de passe)

# =================================================================
# 🛠️ CONFIGURATION SYSTÈME
# =================================================================
# Paramètres d'environnement et de performance
NODE_ENV=production                 # Mode d'exécution (production/development)
LOG_LEVEL=info                      # Réduire le niveau de log pour moins de mémoire
CONTAINER_MEMORY_LIMIT=4g           # Limite mémoire pour les conteneurs Docker
WORKER_CONCURRENCY=2                # Réduire la concurrence pour prévenir les débordements de mémoire

# =================================================================
# 📁 CHEMINS & ESPACES DE TRAVAIL
# =================================================================
# Répertoires utilisés par l'application
HOST_PROJECT_PATH=/home/demon/agentforge/AgenticForge2/AgenticForge    # Chemin du projet sur l'hôte
WORKSPACE_PATH=/home/demon/agentforge/AgenticForge2/AgenticForge/packages/core/workspace       # Workspace par défaut 
WORKER_WORKSPACE_PATH=/home/demon/agentforge/AgenticForge2/AgenticForge/packages/core/workspace  # Workspace worker

# =================================================================
# 🌐 BROWSER LIVE VIEW CONFIGURATION
# =================================================================
BROWSER_LIVE_VIEW_ENABLED=true        # Active les screenshots en temps réel
AUTOMATIC_SCREENSHOTS=true            # Screenshots automatiques lors des actions



