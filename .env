# =================================================================
# FICHIER DE CONFIGURATION PRINCIPAL - AgenticForge
# =================================================================
# 
# 🚀 IMPORTANT: Ce fichier contient TOUTE la configuration de l'application
# 📍 Emplacement: /home/demon/agentforge/AgenticForge2/AgenticForge/.env
# 
# 🤖 POUR L'AGENT IA:
# - Ce fichier définit l'environnement d'exécution complet
#
# =================================================================




# =================================================================
# 🌐 CONFIGURATION RÉSEAU & PORTS
# =================================================================
# Ports utilisés par les différents services
PUBLIC_PORT=3001                    # Port principal du serveur backend
WEB_PORT=3002                      # Port de l'interface web frontend
PORT=3001                          # Port interne du serveur Node.js
SESSION_PORT=3001                  # Port pour la gestion des sessions
VITE_BACKEND_PORT=3001             # Port backend pour le frontend

# =================================================================
# 🔐 AUTHENTIFICATION & SÉCURITÉ
# =================================================================
# Token d'authentification unique pour backend ET frontend
# 📝 Note: Vite injecte automatiquement cette variable dans le frontend
AUTH_TOKEN="Qp5brxkUkTbmWJHmdrGYUjfgNY1hT9WOxUmzpG77JU0"
VITE_AUTH_TOKEN="Qp5brxkUkTbmWJHmdrGYUjfgNY1hT9WOxUmzpG77JU0"

# =================================================================
# 🧠 CONFIGURATION LLM (Large Language Model)
# =================================================================
# Configuration du modèle IA principal
LLM_PROVIDER=gemini                 # Fournisseur IA actuel (qwen/openai/claude/etc.)
LLM_PROVIDER_HIERARCHY=qwen,gemini,openai,anthropic  # Hiérarchie des fournisseurs (fallback) - Qwen en premier pour plus de stabilité
LLM_MODEL_NAME=gemini-2.5-flash    # Modèle spécifique à utiliser (plus rapide et moins restrictif)
LLM_API_KEY=AIzaSyDmfcNia3quV8X58w85GjJn9dZqQ61uObM

# =================================================================
# 🔧 CONFIGURATION ROBUSTESSE AGENT
# =================================================================
# Paramètres pour améliorer la robustesse de l'agent
AGENT_MAX_ITERATIONS=25             # Augmenté pour éviter les arrêts prématurés
AGENT_MAX_MALFORMED_RESPONSES=5     # Plus de tolérance aux réponses malformées
AGENT_MAX_LLM_FAILURES=5            # Plus de tolérance aux échecs LLM
GEMINI_REQUEST_TIMEOUT_MS=45000     # Timeout plus long pour Gemini (45s)
GEMINI_MAX_HISTORY_LENGTH=30        # Réduire l'historique pour éviter les timeouts
LLM_REQUEST_DELAY_MS=2000           # Délai entre les requêtes pour éviter le rate limiting

# =================================================================
# 🗄️ BASE DE DONNÉES POSTGRESQL
# =================================================================
# Configuration de la base de données principale
POSTGRES_HOST=localhost             # Adresse du serveur PostgreSQL
POSTGRES_USER=user                  # Nom d'utilisateur
POSTGRES_PASSWORD=password          # Mot de passe (doit correspondre à Docker)
POSTGRES_DB=gforge                  # Nom de la base de données

# =================================================================
# 🔴 REDIS (Cache & Messages)
# =================================================================
# Configuration Redis pour le cache et la messagerie
REDIS_HOST=localhost                # Adresse du serveur Redis
REDIS_PORT=6379                     # Port Redis standard
REDIS_HOST_PORT=6379               # Port exposé sur l'hôte
REDIS_PASSWORD=""                   # Mot de passe Redis (vide = pas de mot de passe)

# =================================================================
# 🛠️ CONFIGURATION SYSTÈME
# =================================================================
# Paramètres d'environnement et de performance
NODE_ENV=production                 # Mode d'exécution (production/development)
LOG_LEVEL=info                      # Réduire le niveau de log pour moins de mémoire
CONTAINER_MEMORY_LIMIT=4g           # Limite mémoire pour les conteneurs Docker
WORKER_CONCURRENCY=2                # Réduire la concurrence pour prévenir les débordements de mémoire

# =================================================================
# 📁 CHEMINS & ESPACES DE TRAVAIL
# =================================================================
# Répertoires utilisés par l'application
HOST_PROJECT_PATH=/home/demon/agentforge/AgenticForge2/AgenticForge    # Chemin du projet sur l'hôte
WORKSPACE_PATH=/home/demon/agenticforge-workspace                      # Workspace système (pas Docker)



